<https://w3id.org/citydata/21972/v1/IndicatorsSHACL> rdf:type owl:Ontology ;
                                                      owl:imports i72:IndicatorsPattern ;
                                                      dcterms:creator "Kenneth Vaughn"@en ,
                                                                      "Mark S. Fox"@en ;
