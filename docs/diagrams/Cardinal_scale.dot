// Diagram for Cardinal_scale
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		Measurement_scale [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Measurement_scale</TD></TR></TABLE>> URL="../Measurement_scale" margin=0]
	}
	Cardinal_scale [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Cardinal_scale</TD></TR></TABLE>> URL="../Cardinal_scale" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		Fixed_point [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Fixed_point</TD></TR></TABLE>> URL="../Fixed_point" margin=0]
	}
	Cardinal_scale -> Measurement_scale [arrowhead=onormal style=solid]
	Cardinal_scale -> Invis [style=invis]
	Invis -> Fixed_point [style=invis]
	Fixed_point [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Fixed_point</TD></TR></TABLE>> URL="../Fixed_point" margin=0]
	Cardinal_scale -> Fixed_point [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">element</TD></TR></TABLE>> arrowhead=normal style=solid]
}
