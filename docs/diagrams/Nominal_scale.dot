// Diagram for Nominal_scale
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=max
		Nominal_scale [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER" PORT="e">Nominal_scale</TD></TR></TABLE>> URL="../Nominal_scale.md" margin=0]
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		Measurement_scale_category [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Measurement_scale_category</TD></TR></TABLE>> URL="../Measurement_scale_category.md" margin=0]
	}
	Measurement_scale [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Measurement_scale</TD></TR></TABLE>> URL="../Measurement_scale.md" margin=0]
	Nominal_scale -> Measurement_scale [arrowhead=onormal style=solid]
	Nominal_scale -> Invis [style=invis]
	Invis -> Measurement_scale_category [style=invis]
	Nominal_scale -> Measurement_scale_category [label=" element 
 «only»  " arrowhead=normal style=solid]
}
