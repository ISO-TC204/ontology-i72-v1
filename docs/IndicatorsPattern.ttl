@prefix : <https://w3id.org/citydata/21972/v1/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix i72: <https://w3id.org/citydata/21972/v1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/citydata/21972/v1/> .

<https://w3id.org/citydata/21972/v1/IndicatorsPattern> rdf:type owl:Ontology ;
                                                        owl:versionIRI <https://w3id.org/citydata/21972/v1/IndicatorsPattern/r1.2.0-alpha> ;
                                                        owl:imports <https://w3id.org/citydata/21972/v1/CorePattern/r1.2.0-alpha> ;
                                                        dcterms:bibliographicCitation "ISO 21972 Information technology — Upper level ontology for smart city indicators" ;
                                                        dcterms:creator "Kenneth Vaughn"@en ,
                                                                        "Mark S. Fox"@en ,
                                                                        "Megan Katsumi" ;
                                                        dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
                                                        dcterms:modified "2026-07-23"^^xsd:date ;
                                                        dcterms:title "ISO 21972 Ontology - Indicators Pattern"@en ;
                                                        vann:preferredNamespacePrefix "i72" ;
                                                        vann:preferredNamespaceUri "https://w3id.org/citydata/21972/v1/" ;
                                                        owl:priorVersion <https://w3id.org/citydata/21972/v1/1.1.0> ;
                                                        owl:versionInfo "1.1.2-alpha" ;
                                                        skos:definition "Concepts for quantities, units of measure, measurement scales, statistics, and smart city indicators from ISO 21972."@en ;
                                                        adms:relatedDocumentation """ISO21972

Includes a subset of: W3C Owl-Time, GeoSPARQL, and Geonames ontologies""" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/bibliographicCitation
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://schema.org/domainIncludes
schema:domainIncludes rdf:type owl:AnnotationProperty .


###  http://schema.org/rangeIncludes
schema:rangeIncludes rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/adms#relatedDocumentation
adms:relatedDocumentation rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/citydata/21972/v1/cardinalityOf
i72:cardinalityOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf i72:iso21972ObjectProperty ,
                                     [ owl:inverseOf i72:isDescribedBy
                                     ] .


###  https://w3id.org/citydata/21972/v1/definedBy
i72:definedBy rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/forCity
i72:forCity rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/forFeature
i72:forFeature rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/forTimeInterval
i72:forTimeInterval rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/hasCharacteristic
i72:hasCharacteristic rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/hasDenominator
i72:hasDenominator rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/hasNumerator
i72:hasNumerator rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/hasPhenomenon
i72:hasPhenomenon rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/hasPrefix
i72:hasPrefix rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/hasUnit
i72:hasUnit rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/hasValue
i72:hasValue rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/isCharacteristicOf
i72:isCharacteristicOf rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/isComposedOf
i72:isComposedOf rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/isDescribedBy
i72:isDescribedBy rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/isEstimateOf
i72:isEstimateOf rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/isPartOf
i72:isPartOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/iso21972ObjectProperty
i72:iso21972ObjectProperty rdf:type owl:ObjectProperty .


###  https://w3id.org/citydata/21972/v1/locatedIn
i72:locatedIn rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/maxOf
i72:maxOf rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf i72:iso21972ObjectProperty ,
                             [ owl:inverseOf i72:isDescribedBy
                             ] .


###  https://w3id.org/citydata/21972/v1/meanOf
i72:meanOf rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf i72:iso21972ObjectProperty ,
                              [ owl:inverseOf i72:isDescribedBy
                              ] .


###  https://w3id.org/citydata/21972/v1/measurementScale
i72:measurementScale rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/memberOf
i72:memberOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/minOf
i72:minOf rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf i72:iso21972ObjectProperty ,
                             [ owl:inverseOf i72:isDescribedBy
                             ] .


###  https://w3id.org/citydata/21972/v1/parameterOfVar
i72:parameterOfVar rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/singularUnit
i72:singularUnit rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/stdOf
i72:stdOf rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf i72:iso21972ObjectProperty ,
                             [ owl:inverseOf i72:isDescribedBy
                             ] .


###  https://w3id.org/citydata/21972/v1/sumOf
i72:sumOf rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf i72:iso21972ObjectProperty ,
                             [ owl:inverseOf i72:isDescribedBy
                             ] .


###  https://w3id.org/citydata/21972/v1/term_1
i72:term_1 rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/term_2
i72:term_2 rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf i72:iso21972ObjectProperty .


###  https://w3id.org/citydata/21972/v1/zeroElement
i72:zeroElement rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf i72:iso21972ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/citydata/21972/v1/factor
i72:factor rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf i72:iso21972DataProperty .


###  https://w3id.org/citydata/21972/v1/hasLiteralValue
i72:hasLiteralValue rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf i72:iso21972DataProperty .


###  https://w3id.org/citydata/21972/v1/hasName
i72:hasName rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf i72:iso21972DataProperty .


###  https://w3id.org/citydata/21972/v1/hasNumericalValue
i72:hasNumericalValue rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf i72:hasLiteralValue .


###  https://w3id.org/citydata/21972/v1/iso21972DataProperty
i72:iso21972DataProperty rdf:type owl:DatatypeProperty .


###  https://w3id.org/citydata/21972/v1/symbol
i72:symbol rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf i72:iso21972DataProperty .


#################################################################
#    Classes
#################################################################

###  http://www.opengis.net/ont/geosparql#Feature
geo:Feature rdf:type owl:Class .


###  http://www.w3.org/2006/time#DateTimeInterval
time:DateTimeInterval rdf:type owl:Class .


###  https://w3id.org/citydata/21972/v1/Cardinality
i72:Cardinality rdf:type owl:Class ;
                rdfs:subClassOf i72:Parameter ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty i72:cardinalityOf ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass i72:Population
                                ] ;
                rdfs:comment "Cardinality denotes a count of the Population's size." .


###  https://w3id.org/citydata/21972/v1/CardinalityUnit
i72:CardinalityUnit rdf:type owl:Class ;
                    rdfs:subClassOf i72:SingularUnit ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty i72:measurementScale ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass i72:RatioScale
                                    ] ;
                    rdfs:comment """CardinalityUnit denotes a UnitOfMeasure for cardinality. CardinalityUnits (e.g., population counts) are commonly required to define city indicators.
It is a singular unit that uses the ratio measurement scale.""" .


###  https://w3id.org/citydata/21972/v1/City
i72:City rdf:type owl:Class ;
         rdfs:subClassOf i72:Feature ;
         rdfs:comment "A Feature corresponding to the area of a municipality." .


###  https://w3id.org/citydata/21972/v1/CompoundUnit
i72:CompoundUnit rdf:type owl:Class ;
                 rdfs:subClassOf i72:UnitOfMeasure ;
                 rdfs:comment "CompoundUnit is comprised from a combination of UnitOfMeasures." .


###  https://w3id.org/citydata/21972/v1/DifferenceIndicator
i72:DifferenceIndicator rdf:type owl:Class ;
                        rdfs:subClassOf i72:DifferenceQuantity ,
                                        i72:Indicator ;
                        rdfs:comment "An Indicator that is also a DifferenceQuantity." .


###  https://w3id.org/citydata/21972/v1/DifferenceQuantity
i72:DifferenceQuantity rdf:type owl:Class ;
                       rdfs:subClassOf i72:Quantity ,
                                       [ rdf:type owl:Class ;
                                         owl:unionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty i72:term_1 ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass i72:Quantity
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty i72:term_2 ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass i72:Quantity
                                                       ]
                                                     )
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty i72:hasUnit ;
                                         owl:allValuesFrom i72:UnitDifference
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty i72:term_1 ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass [ rdf:type owl:Class ;
                                                       owl:unionOf ( i72:Quantity
                                                                     i72:SpecifiedQuantity
                                                                   )
                                                     ]
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty i72:term_2 ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass [ rdf:type owl:Class ;
                                                       owl:unionOf ( i72:Quantity
                                                                     i72:SpecifiedQuantity
                                                                   )
                                                     ]
                                       ] ;
                       rdfs:comment "DifferenceQuantity defines a Quantity that can be derived from the subtraction of two Quantities or QuantitySpecifications. At least one of term_1 or term_2 must be a Quantity." .


###  https://w3id.org/citydata/21972/v1/DivisionQuantity
i72:DivisionQuantity rdf:type owl:Class ;
                     rdfs:subClassOf i72:Quantity ,
                                     [ rdf:type owl:Class ;
                                       owl:unionOf ( [ rdf:type owl:Restriction ;
                                                       owl:onProperty i72:hasDenominator ;
                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onClass i72:Quantity
                                                     ]
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty i72:hasNumerator ;
                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onClass i72:Quantity
                                                     ]
                                                   )
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty i72:hasUnit ;
                                       owl:allValuesFrom i72:UnitDivision
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty i72:hasDenominator ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass [ rdf:type owl:Class ;
                                                     owl:unionOf ( i72:Quantity
                                                                   i72:SpecifiedQuantity
                                                                 )
                                                   ]
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty i72:hasNumerator ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass [ rdf:type owl:Class ;
                                                     owl:unionOf ( i72:Quantity
                                                                   i72:SpecifiedQuantity
                                                                 )
                                                   ]
                                     ] ;
                     rdfs:comment "DivisionQuantity defines a Quantity that can be derived from the division of Quantities or QuantitySpecifications. At least one of either the numerator or denominator must be a Quantity." .


###  https://w3id.org/citydata/21972/v1/Feature
i72:Feature rdf:type owl:Class ;
            rdfs:subClassOf geo:Feature ,
                            i72:ISO21972Thing ,
                            <https://www.geonames.org/ontology#Feature> ;
            rdfs:comment "A Feature is defined as some geographic entity. It is a specialization of GeoSPARQL's Feature (that refers to any object with a spatial extent), and Geonames' Feature (that refers specifically to geographic entities, but does not explicitly define an associated geometry that describes the location." .


###  https://w3id.org/citydata/21972/v1/FixedZeroPoint
i72:FixedZeroPoint rdf:type owl:Class ;
                   rdfs:subClassOf i72:Measure ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty i72:hasNumericalValue ;
                                     owl:hasValue 0
                                   ] ;
                   rdfs:comment "FixedZeroPoint is a Measure with a value of 0." .


###  https://w3id.org/citydata/21972/v1/ISO21972Thing
i72:ISO21972Thing rdf:type owl:Class .


###  https://w3id.org/citydata/21972/v1/Indicator
i72:Indicator rdf:type owl:Class ;
              rdfs:subClassOf i72:Quantity ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty i72:forCity ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass i72:City
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty i72:forFeature ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass i72:Feature
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty i72:forTimeInterval ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass time:DateTimeInterval
                              ] ;
              rdfs:comment "Indicator is a type of Quantity that is specialized to denote a measurable characteristic of a city. It extends Quantity with properties to define the geospatial area that it is a measurement of, and more generally, the city that it is defined for, as well as the time interval during which it was measured." .


###  https://w3id.org/citydata/21972/v1/IntervalScale
i72:IntervalScale rdf:type owl:Class ;
                  rdfs:subClassOf i72:Scale ;
                  rdfs:comment "IntervalScale refers to a Scale in which there are equal distances between ordered values, but no true zero point." .


###  https://w3id.org/citydata/21972/v1/MaxValue
i72:MaxValue rdf:type owl:Class ;
             rdfs:subClassOf i72:Parameter ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty i72:maxOf ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass i72:Population
                             ] ;
             rdfs:comment "MaxValue denotes the maximum value of a specific Variable in the Population." .


###  https://w3id.org/citydata/21972/v1/Mean
i72:Mean rdf:type owl:Class ;
         rdfs:subClassOf i72:Parameter ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty i72:meanOf ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass i72:Population
                         ] ;
         rdfs:comment "Mean denotes the mean of a specific Variable of the Population" .


###  https://w3id.org/citydata/21972/v1/Measure
i72:Measure rdf:type owl:Class ;
            rdfs:subClassOf i72:ISO21972Thing ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty i72:hasUnit ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass i72:UnitOfMeasure
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty i72:hasLiteralValue ;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                            ] ;
            rdfs:comment "Measure denotes a specific value. It is defined with a literal value (often numerical), a UnitOfMeasure, and can be linked to a Quantity that it is a measurement of." .


###  https://w3id.org/citydata/21972/v1/MinValue
i72:MinValue rdf:type owl:Class ;
             rdfs:subClassOf i72:Parameter ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty i72:minOf ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass i72:Population
                             ] ;
             rdfs:comment "MinValue denotes the minimum value of a specific Variable in the Population." .


###  https://w3id.org/citydata/21972/v1/MonetaryUnit
i72:MonetaryUnit rdf:type owl:Class ;
                 rdfs:subClassOf i72:SingularUnit ;
                 rdfs:comment "MonetaryUnit denotes a UnitOfMeasure used to measure amounts of money. MonetaryUnit individuals use the codes for currencies in accordance with ISO 4217." .


###  https://w3id.org/citydata/21972/v1/MultiplicationIndicator
i72:MultiplicationIndicator rdf:type owl:Class ;
                            rdfs:subClassOf i72:Indicator ,
                                            i72:MultiplicationQuantity ;
                            rdfs:comment "An Indicator that is also a MultiplicationQuantity." .


###  https://w3id.org/citydata/21972/v1/MultiplicationQuantity
i72:MultiplicationQuantity rdf:type owl:Class ;
                           rdfs:subClassOf i72:Quantity ,
                                           [ rdf:type owl:Class ;
                                             owl:unionOf ( [ rdf:type owl:Restriction ;
                                                             owl:onProperty i72:term_1 ;
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onClass i72:Quantity
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty i72:term_2 ;
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onClass i72:Quantity
                                                           ]
                                                         )
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty i72:hasUnit ;
                                             owl:allValuesFrom i72:UnitMultiplication
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty i72:term_1 ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass [ rdf:type owl:Class ;
                                                           owl:unionOf ( i72:Quantity
                                                                         i72:SpecifiedQuantity
                                                                       )
                                                         ]
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty i72:term_2 ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass [ rdf:type owl:Class ;
                                                           owl:unionOf ( i72:Quantity
                                                                         i72:SpecifiedQuantity
                                                                       )
                                                         ]
                                           ] ;
                           rdfs:comment "MultiplicationQuantity defines a Quantity that can be derived from the multiplication of Quantities or QuantitySpecifications. At least one of term_1 or term_2 must be a Quantity." .


###  https://w3id.org/citydata/21972/v1/NominalScale
i72:NominalScale rdf:type owl:Class ;
                 rdfs:subClassOf i72:Scale ;
                 rdfs:comment "NominalScale refers to a Scale in which values are classified into distinct categories." .


###  https://w3id.org/citydata/21972/v1/Observation
i72:Observation rdf:type owl:Class ;
                rdfs:subClassOf i72:ISO21972Thing ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty i72:memberOf ;
                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( i72:Population
                                                                    i72:Sample
                                                                  )
                                                    ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty i72:hasCharacteristic ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass i72:Variable
                                ] ;
                rdfs:comment "Observation denotes the individual Population member(s) that make up a Sample. Observations are defined by the Sample they correspond to and the Variable that is being measured (i.e., to estimate the property for the sample)." .


###  https://w3id.org/citydata/21972/v1/OrdinalScale
i72:OrdinalScale rdf:type owl:Class ;
                 rdfs:subClassOf i72:Scale ;
                 rdfs:comment "OrdinalScale refers to a Scale in which values are assigned as an ordering." .


###  https://w3id.org/citydata/21972/v1/Parameter
i72:Parameter rdf:type owl:Class ;
              rdfs:subClassOf i72:Quantity ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty i72:parameterOfVar ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass i72:Variable
                              ] ;
              rdfs:comment "Parameter denotes a statistical description of population, such as the mean or maximum of some attribute of the population members. For example, the average income in a city is a Parameter of the city's Population of residents." .


###  https://w3id.org/citydata/21972/v1/Population
i72:Population rdf:type owl:Class ;
               rdfs:subClassOf i72:ISO21972Thing ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty i72:definedBy ;
                                 owl:allValuesFrom owl:Thing
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty i72:forTimeInterval ;
                                 owl:allValuesFrom time:DateTimeInterval
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty i72:isDescribedBy ;
                                 owl:allValuesFrom i72:Parameter
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty i72:locatedIn ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass i72:Feature
                               ] ;
               rdfs:comment "Populations are defined in a statistical sense. They refer not only to groups of people, but to a finite collection of “things” under consideration. Populations are defined by their membership, spatial, and temporal extent." .


###  https://w3id.org/citydata/21972/v1/Prefix
i72:Prefix rdf:type owl:Class ;
           rdfs:subClassOf i72:ISO21972Thing ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty i72:factor ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:double
                           ] ;
           rdfs:comment "Prefix defines a prefix associated with a UnitMultiple that indicates its relationship (scale) to the SingularUnit." .


###  https://w3id.org/citydata/21972/v1/Quantity
i72:Quantity rdf:type owl:Class ;
             rdfs:subClassOf i72:ISO21972Thing ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty i72:hasUnit ;
                               owl:someValuesFrom i72:UnitOfMeasure
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty i72:hasValue ;
                               owl:someValuesFrom i72:Measure
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty i72:measurementScale ;
                               owl:someValuesFrom i72:Scale
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty i72:hasPhenomenon ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ;
             rdfs:comment "A quantity describes what is being measured, such as the diameter of a ball. It is defined by a link directly to the actual phenomenon being measured, a specific measure that defines the value of the measurement, the unit(s) of measurement used for the quantity, and the scale applied to measure the quantity." .


###  https://w3id.org/citydata/21972/v1/RatioIndicator
i72:RatioIndicator rdf:type owl:Class ;
                   rdfs:subClassOf i72:DivisionQuantity ,
                                   i72:Indicator ;
                   rdfs:comment "An Indicator that is also a DivisionQuantity." .


###  https://w3id.org/citydata/21972/v1/RatioScale
i72:RatioScale rdf:type owl:Class ;
               rdfs:subClassOf i72:Scale ;
               rdfs:comment "RatioScale refers to a Scale in which the value is the ratio of the quantity with the measurement scale. In this scale, values can be meaningfully compared using arithmetic and there is a true zero value that indicates the absence of the quantity." .


###  https://w3id.org/citydata/21972/v1/Sample
i72:Sample rdf:type owl:Class ;
           rdfs:subClassOf i72:ISO21972Thing ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty i72:isComposedOf ;
                             owl:allValuesFrom i72:Observation
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty i72:isDescribedBy ;
                             owl:allValuesFrom i72:Statistic
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty i72:isPartOf ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass i72:Population
                           ] ;
           rdfs:comment """Represents the part of a Population that is measured. It is defined by the individual Observations that it is composed of, and the corresponding statistic (e.g. mean or max of some property) that is measured to describe the sample.
While logically a kind of Population, the two are kept separate due to the fundamental distinction between the two concepts in statistics.""" .


###  https://w3id.org/citydata/21972/v1/SampleMean
i72:SampleMean rdf:type owl:Class ;
               rdfs:subClassOf i72:Statistic .


###  https://w3id.org/citydata/21972/v1/SampleStandardDeviation
i72:SampleStandardDeviation rdf:type owl:Class ;
                            rdfs:subClassOf i72:Statistic .


###  https://w3id.org/citydata/21972/v1/Scale
i72:Scale rdf:type owl:Class ;
          rdfs:subClassOf i72:ISO21972Thing ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty i72:zeroElement ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass i72:FixedZeroPoint
                          ] ;
          rdfs:comment "Scale refers to the measurement scale of a UnitOfMeasure. Measurement scales provide a characterization of how values are quantified and interpreted for a particular unit." .


###  https://w3id.org/citydata/21972/v1/SingularUnit
i72:SingularUnit rdf:type owl:Class ;
                 rdfs:subClassOf i72:UnitOfMeasure ;
                 rdfs:comment "SingularUnit refers to the base unit that serves as the building block for a UnitOMeasure, such as a metre." .


###  https://w3id.org/citydata/21972/v1/SpecifiedQuantity
i72:SpecifiedQuantity rdf:type owl:Class ;
                      rdfs:subClassOf i72:ISO21972Thing ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty i72:hasValue ;
                                        owl:someValuesFrom i72:Measure
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty i72:hasUnit ;
                                        owl:allValuesFrom i72:UnitOfMeasure
                                      ] ;
                      rdfs:comment "SpecifiedQuantity denotes an amount that is defined as opposed to measured. It  has no associated phenomenon, but is defined with a Measure and UnitOfMeasure." .


###  https://w3id.org/citydata/21972/v1/StandardDeviation
i72:StandardDeviation rdf:type owl:Class ;
                      rdfs:subClassOf i72:Parameter ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty i72:stdOf ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass i72:Population
                                      ] ;
                      rdfs:comment "StandardDeviation denotes the standard deviation of a specific variable of the Population." .


###  https://w3id.org/citydata/21972/v1/Statistic
i72:Statistic rdf:type owl:Class ;
              rdfs:subClassOf i72:Quantity ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty i72:isEstimateOf ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass i72:Parameter
                              ] ;
              rdfs:comment "Statistic denotes the parameter that is being measured for a particular Sample. While logically a kind of Parameter, the two are kept separate due to the fundamental distinction between the two concepts in statistics." .


###  https://w3id.org/citydata/21972/v1/Sum
i72:Sum rdf:type owl:Class ;
        rdfs:subClassOf i72:Parameter ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty i72:sumOf ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass i72:Population
                        ] .


###  https://w3id.org/citydata/21972/v1/SumIndicator
i72:SumIndicator rdf:type owl:Class ;
                 rdfs:subClassOf i72:Indicator ,
                                 i72:SumQuantity ;
                 rdfs:comment "An Indicator that is also a SumQuantity (i.e., can be derived from the addition of quantities)." .


###  https://w3id.org/citydata/21972/v1/SumQuantity
i72:SumQuantity rdf:type owl:Class ;
                rdfs:subClassOf i72:Quantity ,
                                [ rdf:type owl:Class ;
                                  owl:unionOf ( [ rdf:type owl:Restriction ;
                                                  owl:onProperty i72:term_1 ;
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass i72:Quantity
                                                ]
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty i72:term_2 ;
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass i72:Quantity
                                                ]
                                              )
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty i72:hasUnit ;
                                  owl:allValuesFrom i72:UnitSum
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty i72:term_1 ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass [ rdf:type owl:Class ;
                                                owl:unionOf ( i72:Quantity
                                                              i72:SpecifiedQuantity
                                                            )
                                              ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty i72:term_2 ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass [ rdf:type owl:Class ;
                                                owl:unionOf ( i72:Quantity
                                                              i72:SpecifiedQuantity
                                                            )
                                              ]
                                ] ;
                rdfs:comment "SumQuantity defines a Quantity that can be derived from the sum of two Quantities or QuantitySpecifications. At least one of term_1 or term_2 must be a Quantity." .


###  https://w3id.org/citydata/21972/v1/UnitDifference
i72:UnitDifference rdf:type owl:Class ;
                   rdfs:subClassOf i72:CompoundUnit ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty i72:term_1 ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass i72:UnitOfMeasure
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty i72:term_2 ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass i72:UnitOfMeasure
                                   ] ;
                   rdfs:comment "UnitDifference refers to a unit that is defined as the difference between two UnitOfMeasures." .


###  https://w3id.org/citydata/21972/v1/UnitDivision
i72:UnitDivision rdf:type owl:Class ;
                 rdfs:subClassOf i72:CompoundUnit ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty i72:hasDenominator ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass i72:UnitOfMeasure
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty i72:hasNumerator ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass i72:UnitOfMeasure
                                 ] ;
                 rdfs:comment "UnitDivision refers to a unit that is defined as the division of two UnitOfMeasures." .


###  https://w3id.org/citydata/21972/v1/UnitMultiple
i72:UnitMultiple rdf:type owl:Class ;
                 rdfs:subClassOf i72:UnitOfMeasure ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty i72:hasPrefix ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass i72:Prefix
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty i72:singularUnit ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass i72:SingularUnit
                                 ] ;
                 rdfs:comment "UnitMultiple refers to a unit that is a multiples or submultiples of a SingularUnit. It is defined according to a SingularUnit and a Prefix that defines the factor from the base (Singular) unit." .


###  https://w3id.org/citydata/21972/v1/UnitMultiplication
i72:UnitMultiplication rdf:type owl:Class ;
                       rdfs:subClassOf i72:CompoundUnit ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty i72:term_1 ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass i72:UnitOfMeasure
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty i72:term_2 ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass i72:UnitOfMeasure
                                       ] ;
                       rdfs:comment "UnitMultiplication refers to a unit that is defined as the multiplication of two UnitOfMeasures." .


###  https://w3id.org/citydata/21972/v1/UnitOfMeasure
i72:UnitOfMeasure rdf:type owl:Class ;
                  rdfs:subClassOf i72:ISO21972Thing ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty i72:measurementScale ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass i72:Scale
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty i72:symbol ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ;
                  rdfs:comment "UnitOfMeasure specifies the actual units in which some quantity (or specified quantity) is measured. For example, length is a quantity; the metre is a unit of length that represents a definite predetermined length. UnitOfMeasure has a defined symbol(s) that is used to denote it, and measurement scale." .


###  https://w3id.org/citydata/21972/v1/UnitSum
i72:UnitSum rdf:type owl:Class ;
            rdfs:subClassOf i72:CompoundUnit ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty i72:term_1 ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass i72:UnitOfMeasure
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty i72:term_2 ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass i72:UnitOfMeasure
                            ] ;
            rdfs:comment "UnitSum refers to a unit that is defined as the sum of two UnitOfMeasures." .


###  https://w3id.org/citydata/21972/v1/Variable
i72:Variable rdf:type owl:Class ;
             rdfs:subClassOf i72:ISO21972Thing ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty i72:isCharacteristicOf ;
                               owl:allValuesFrom i72:Observation
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty i72:hasName ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ;
             rdfs:comment """Variable denotes the property that is being measured in a particular Population. For example, \"hasIncome\" could be a property that is measured across a city's Population to derive the Parameter of its average income.
It is defined according to the Observation(s) that have the property and the name (IRI) with which the property is defined.""" .


